# --- Firecrawl (used by `okf-mcp ingest` for URLs) ---
OKF_MCP_FIRECRAWL_API_URL=https://api.firecrawl.dev
# Checked before the OS keychain/encrypted-file fallback `okf-mcp setup`
# writes to.
OKF_MCP_FIRECRAWL_API_PAT=

# --- LLM provider (used by `okf-mcp compile`/`rebuild`) ---
# Set the key(s) for whichever provider(s) you pass to --model
# <provider>/<model_name>. Only one is required if you only use one provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# ollama needs no key; only set OLLAMA_HOST if it's not the default:
OLLAMA_HOST=http://localhost:11434
# foundry-local needs no key; its port is dynamic per machine, so this has
# no default and must be set to use it (see `foundry service status`):
FOUNDRY_LOCAL_ENDPOINT=
# claude-max-api-proxy needs no key (it authenticates via your already
# logged-in `claude` CLI session); only set this if you didn't run it on
# its own default http://localhost:3456/v1 (do NOT point this at 11434 —
# that's Ollama's port, and would silently hit Ollama instead if it's
# also running):
CLAUDE_MAX_API_PROXY_ENDPOINT=
# custom/<model_name>: any other OpenAI-compatible endpoint (self-hosted, etc.)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# --- Server ---
OKF_MCP_LOG_LEVEL=info
