# --- Firecrawl (used by `okf-mcp ingest` for URLs) ---
OKF_MCP_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Either name works — checked before the OS keychain/encrypted-file
# fallback `okf-mcp setup` writes to.
OKF_MCP_TOKEN=
# OKF_MCP_API_KEY=

# --- LLM provider (used by `okf-mcp compile`/`rebuild`) ---
# Set the key(s) for whichever provider(s) you pass to --model
# <provider>/<model_name>. Only one is required if you only use one provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# ollama needs no key; only set OLLAMA_HOST if it's not the default:
OLLAMA_HOST=http://localhost:11434
# custom/<model_name>: any other OpenAI-compatible endpoint (self-hosted, etc.)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# --- Server ---
OKF_MCP_LOG_LEVEL=info
